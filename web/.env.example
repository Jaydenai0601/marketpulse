# 数据库连接（本地 PostgreSQL 示例）
# 生产环境用 Vercel Postgres 会自动注入 POSTGRES_PRISMA_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketpulse?schema=public"

# 用于保护 /api/run 和 /api/import 等内部接口
CRON_SECRET="your-random-secret-here"

# DeepSeek API Key（Python 爬虫用）
DEEPSEEK_API_KEY="your-deepseek-api-key"
